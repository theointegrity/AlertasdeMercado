# Copie este arquivo para ".env" (uso local) e preencha com valores reais.
# Em produção (GitHub Actions), estas variáveis vêm de GitHub Secrets,
# nunca deste arquivo.

# Conta de e-mail que envia os alertas (Gmail com senha de app, não a senha normal)
EMAIL_USER=theo@integritywm.com.br
EMAIL_PASS=senha_de_app_do_gmail

# Nome de exibição do remetente (opcional)
EMAIL_NOME_EXIBICAO=Alertas de Mercado | Integrity WM
